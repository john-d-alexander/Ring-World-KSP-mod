# DRAFT ONLY: coordinate Cyla dependency ownership with NetKAN before submitting.
identifier: NivenRingworld
name: Niven Ringworld Expedition
abstract: A landable rotating Ringworld with procedural terrain, atmosphere and ring-relative flight.
license:
  - MIT
  - GPL-3.0
$kref: '#/ckan/github/theplatecrafter/Ring-World-KSP-mod'
$vref: '#/ckan/ksp-avc'
depends:
  - name: Harmony2
    min_version: 2.2.1.0
install:
  - file: GameData/NivenRingworld
    install_to: GameData

# Cyla must be packaged/indexed as its own dependency or explicitly assigned ownership.
# This incomplete example deliberately does not copy a second unowned Cyla folder.
